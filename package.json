{
	"name": "pi-subagents",
	"version": "2.7.0",
	"description": "Power-user multi-agent framework for Pi: named agents, interactive sessions via Herdr/cmux/tmux/zellij/WezTerm, background workers, async/sync coordination, fork/resume, child-to-parent messaging, orchestrator mode, and a live TUI",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"author": "edxeth",
	"repository": {
		"type": "git",
		"url": "https://github.com/edxeth/pi-subagents"
	},
	"type": "module",
	"scripts": {
		"test": "node --test test/test.ts test/system-prompt-mode.test.ts test/runtime/widget.test.ts test/mux/cmux.test.ts test/live-test-guard.test.ts",
		"test:e2e-live-blocking": "node scripts/test-e2e-live-blocking.mjs",
		"test:e2e-live-mix-blocking": "node scripts/test-e2e-live-mix-blocking.mjs",
		"test:e2e-live-deny-tools": "node scripts/test-e2e-live-deny-tools.mjs",
		"test:e2e-live-tools": "node scripts/test-e2e-live-tools.mjs",
		"test:e2e-live-extensions": "node scripts/test-e2e-live-extensions.mjs",
		"test:e2e-live-stop-after-turn": "node scripts/test-e2e-live-stop-after-turn.mjs",
		"test:e2e-live-mixed-batch": "node scripts/test-e2e-live-mixed-batch.mjs",
		"test:frontmatter-timeout": "node scripts/test-frontmatter-timeout.mjs",
		"test:frontmatter-idle-timeout": "node scripts/test-frontmatter-idle-timeout.mjs",
		"test:frontmatter-timeout-warn": "node scripts/test-frontmatter-timeout-warn.mjs",
		"test:frontmatter-on-timeout": "node scripts/test-frontmatter-on-timeout.mjs",
		"test:live-herdr-mux": "node scripts/test-live-herdr-mux.mjs",
		"test:live-herdr-pi": "node scripts/test-live-herdr-pi.mjs",
		"test:live-herdr-timeout-wrap-up": "node scripts/test-live-herdr-timeout-wrap-up.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.79.0",
		"@earendil-works/pi-coding-agent": ">=0.79.10",
		"@earendil-works/pi-tui": ">=0.79.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.84.0",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"@earendil-works/pi-tui": "^0.84.0",
		"@types/node": "^25.9.1",
		"typebox": "^1.1.33",
		"typescript": "^6.0.3"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"knip": {
		"ignoreBinaries": [
			"cmux",
			"ghostty",
			"herdr",
			"pkill",
			"where.exe",
			"wezterm",
			"zellij"
		],
		"ignoreFiles": [
			"scripts/check-file-sizes.mjs"
		]
	},
	"trustedDependencies": [
		"koffi",
		"protobufjs"
	]
}
